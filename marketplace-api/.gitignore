.vs/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUNIT
*.VisualState.xml
TestResult.xml

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
**/Properties/launchSettings.json

# VS Code
.vscode/

# Compiler/intermediate files
*_i.c
*_p.c
*_i.h
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Visual C++ cache
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

# Profiling
*.psess
*.vsp
*.vspx
*.sap

# ReSharper
_ReSharper*/
*.DotSettings.user

# Rider
.idea/
*.sln.iml

# TeamCity
_TeamCity*

# DotCover
*.dotCover

# Code coverage
*.coverage
*.coveragexml

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# Web workbench (sass)
.sass-cache/

# ClickOnce
publish/

# Publish Web Output
*.Publish.xml
*.azurePubxml
*.pubxml
*.publishproj
PublishScripts/

# NuGet
*.nupkg
**/packages/*
!**/packages/build/

# Azure build output
csx/
*.build.csdef

# Azure Emulator
ecf/
rcf/

# Windows Store
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt

# SQL Server
*.mdf
*.ldf

# Others
ClientBin/
~$*
*~
*.dbmdl
*.jfm
*.pfx
*.publishsettings
orleans.codegen.cs

# RIA/Silverlight
Generated_Code/

# Backup & upgrade logs
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm

# Node.js (common in API frontends)
node_modules/

# Typescript
typings/

# Paket
.paket/paket.exe
paket-files/

# FAKE
.fake/

# Python Tools for Visual Studio
__pycache__/
*.pyc

# BizTalk
*.btp.cs
*.btm.cs
*.odx.cs
*.xsd.cs

# LightSwitch
**/*.HTMLClient/GeneratedArtifacts
**/*.DesktopClient/GeneratedArtifacts
**/*.DesktopClient/ModelManifest.xml
**/*.Server/GeneratedArtifacts
**/*.Server/ModelManifest.xml
_Pvt_Extensions/

# UWP
AppPackages/

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

