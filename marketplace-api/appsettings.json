{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=student_marketplace.db"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_LONG_RANDOM_SECRET_32+_CHARS",
    "Issuer": "StudentMarketplace",
    "Audience": "StudentMarketplaceClient",
    "ExpiryMinutes": 60
  },
  "Admin": {
    "DefaultPassword": "CHANGE_ME_ON_FIRST_RUN"
  },
  "Uploads": {
    "MaxFileSizeMB": 2,
    "MaxImagesPerListing": 5
  },
  "Features": {
    "RequireListingApproval": false
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
